# Variable names only. Copy to supabase/functions/.env for `supabase functions serve`,
# or set them on the hosted project with `supabase secrets set NAME=value`.
# Never commit real values. See docs/community/setup.md.

# Newsletter (Edge Function: newsletter-subscribe)
BUTTONDOWN_API_KEY=
# Comma-separated origins allowed to call the functions, e.g. https://aipel.co.uk,http://localhost:4000
ALLOWED_ORIGINS=
# Optional Cloudflare Turnstile secret; when set, the form must pass the check
TURNSTILE_SECRET_KEY=
